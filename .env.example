# GTAVCAD shared production backend configuration
# Use the same values for gtavcad.com and gtavcad.app so both domains read/write
# the same users, CAD records, dispatch records, unit statuses, alerts, and sessions.

# Flask / deployment mode
FLASK_ENV=production
APP_ENV=production
PLATFORM_NAME=GTAVCAD
PLATFORM_DOMAIN=gtavcad.app
PUBLIC_BASE_URL=https://gtavcad.app
APP_BASE_URL=https://gtavcad.app

# Shared database (required)
# Set this to the production backend database used by the app. Do not use a local
# or per-domain database if gtavcad.com and gtavcad.app must share data.
DATABASE_URL=postgresql://username:password@host:5432/gtavcad

# Shared Flask session/JWT secrets (required)
# Generate strong random values in the host control panel. Do not commit real secrets.
SECRET_KEY=replace-with-a-random-32-plus-character-secret
JWT_SECRET=replace-with-the-same-random-jwt-secret-on-all-domains
JWT_ISSUER=gtavcad
JWT_AUDIENCE=gtavcad-web
JWT_ACCESS_TOKEN_TTL_SECONDS=604800
SESSION_LIFETIME_DAYS=7
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
# Use None when gtavcad.com calls the gtavcad.app API cross-origin with credentials.
SESSION_COOKIE_SAMESITE=None
# Leave blank for host-only cookies. Set only if serving subdomains of one registrable domain.
# SESSION_COOKIE_DOMAIN=

# Shared frontend/backend origin allowlists
# Include every public website domain that will call the shared backend.
CORS_ALLOWED_ORIGINS=https://gtavcad.com,https://www.gtavcad.com,https://gtavcad.app,https://www.gtavcad.app
SOCKETIO_ALLOWED_ORIGINS=https://gtavcad.com,https://www.gtavcad.com,https://gtavcad.app,https://www.gtavcad.app
SOCKETIO_ASYNC_MODE=eventlet

# Optional frontend setting for static deployments
# If a static gtavcad.com build is served separately, configure its runtime/meta
# equivalent to point API calls at the shared backend origin below.
GTAVCAD_API_BASE_URL=https://gtavcad.app

# Platform owner / admin bootstrap
PLATFORM_OWNER_EMAIL=owner@example.com
# ADMIN_PASSWORD_HASH=hashed-password-from-setup-script

# Email notifications
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=replace-with-smtp-password
NOTIFICATION_EMAIL=admin@example.com

# Discord notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# AI service (optional)
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_HTTP_REFERER=https://gtavcad.app
