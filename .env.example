# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/nthacityrp

# Flask Configuration
FLASK_SECRET=your-super-secure-random-secret-key-here-at-least-32-chars
FLASK_ENV=production

# Admin Configuration (optional - will use bootstrap if not set)
# ADMIN_PASSWORD_HASH=hashed-password-from-setup-script

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=admin@nthacityrp.com

# Discord Webhook (for notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Server Configuration
SERVER_NAME=NThaCityRP
SERVER_ID=main

# Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax